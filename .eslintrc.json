{
    "env": {
        "browser": true,
        "es6": true
    },
    "extends": "eslint:recommended",
    "globals": {
        "Atomics": "readonly",
        "SharedArrayBuffer": "readonly"
    },
    "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module"
    },
    "rules": {
        "no-unused-vars": ["warn"],
        "no-console": ["warn"],
        "semi": ["error", "always"],
        "quotes": ["error", "single"],
        "eqeqeq": ["warn"]
    }
}